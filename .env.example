# Supabase (from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: npm run storage:backup — comma-separated bucket names (default: portraits,profile-pictures)
# STORAGE_BACKUP_BUCKETS=portraits,profile-pictures

# Database (from Supabase Dashboard → Settings → Database → Connection string)
# Used by npm run db:backup (pg_dump). Prefer DIRECT_URL (port 5432) for full dumps.
DATABASE_URL=
# Direct connection (port 5432) — recommended for backups and migrations
DIRECT_URL=

# E2E visual baselines (TASK-385 / DEV-003) — run npm run e2e:provision after setting email/password
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
# Optional overrides (defaults match tests/visual/e2e-seed-manifest.json after provision)
E2E_TEST_CHARACTER_ID=
E2E_TEST_CAMPAIGN_ID=

# Public site origin (canonical). Used for auth redirect URLs and for the
# Origin/Sec-Fetch-Site check on state-changing API requests. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile site key (public). Required on production once Supabase Auth
# CAPTCHA is enabled (TASK-899). Secret key goes in Supabase Dashboard only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Durable rate limiting across Vercel serverless instances (TASK-645 / TASK-669).
# Production (2026-08-13): Vercel marketplace Upstash injects KV_REST_API_URL + KV_REST_API_TOKEN.
# Local: leave unset to keep in-memory limiting. rate-limit.ts logs a warning once per process when unset.
# Upstash Redis:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# — or Vercel KV / Upstash marketplace (same REST API shape):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Error monitoring (TASK-745 / DEV-013). App is a no-op until these are set.
# Production (2026-08-13): Vercel marketplace Sentry injects NEXT_PUBLIC_SENTRY_DSN on production + preview.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
